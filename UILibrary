-- ── Toggle ────────────────────────────────────────────────
local function renderToggle(opt, parent)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    make("TextLabel", {
        Size = UDim2.new(1, -56, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = opt.text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = make("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 38, 0, 21),
        BackgroundColor3 = opt.state and T.accent or T.surface3,
    }, row)
    corner(11, track)
    uistroke(T.border, 1, track)

    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = opt.state
            and UDim2.new(0, 19, 0.5, 0)
            or  UDim2.new(0,  2, 0.5, 0),
        Size = UDim2.new(0, 17, 0, 17),
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(9, thumb)

    local function setState(v)
        opt.state = v
        MorLib.flags[opt.flag] = v
        tw(track, { BackgroundColor3 = v and T.accent or T.surface3 }, 0.18)
        tw(thumb, { Position = v and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }, 0.18)
        pcall(opt.callback, v)
    end

    function opt:SetState(v) setState(v) end

    local textLbl = row:FindFirstChildOfClass("TextLabel")
    row.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            setState(not opt.state)
        end
    end)
    row.MouseEnter:Connect(function() tw(textLbl, { TextColor3 = T.accentLight }, 0.1) end)
    row.MouseLeave:Connect(function() tw(textLbl, { TextColor3 = T.text }, 0.1) end)
end

-- ── Button ────────────────────────────────────────────────
local function renderButton(opt, parent)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    local btn = make("TextButton", {
        Size = UDim2.new(1, -16, 1, -8),
        Position = UDim2.new(0, 8, 0, 4),
        BackgroundColor3 = T.surface3,
        Text = opt.text,
        TextSize = 14,
        Font = Enum.Font.GothamSemibold,
        TextColor3 = T.text,
        AutoButtonColor = false,
    }, row)
    corner(7, btn)
    uistroke(T.border, 1, btn)

    btn.MouseButton1Down:Connect(function()
        tw(btn, { BackgroundColor3 = T.accent }, 0.1)
    end)
    btn.MouseButton1Up:Connect(function()
        tw(btn, { BackgroundColor3 = T.surface3 }, 0.18)
        task.spawn(pcall, opt.callback)
    end)
    btn.MouseEnter:Connect(function()
        tw(btn, { BackgroundColor3 = T.surface2 + Color3.fromRGB(12,12,14) }, 0.1)
        uistroke(T.borderLight, 1, btn)
    end)
    btn.MouseLeave:Connect(function()
        tw(btn, { BackgroundColor3 = T.surface3 }, 0.1)
    end)
end

-- ── Label ─────────────────────────────────────────────────
local function renderLabel(opt, parent)
    local lbl = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "  " .. opt.text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = opt._order or 0,
    }, parent)

    -- Support both label.Text = x  and  label:SetText(x)
    function opt:SetText(v)
        lbl.Text = "  " .. tostring(v)
    end
    setmetatable(opt, {
        __newindex = function(t, k, v)
            if k == "Text" then lbl.Text = "  " .. tostring(v) end
            rawset(t, k, v)
        end,
    })
end

-- ── Slider ────────────────────────────────────────────────
local function renderSlider(opt, parent)
    local TRACK = 4

    local wrapper = make("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    make("TextLabel", {
        Size = UDim2.new(1, -64, 0, 22),
        Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1,
        Text = opt.text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, wrapper)

    local valLbl = make("TextLabel", {
        Size = UDim2.new(0, 54, 0, 22),
        Position = UDim2.new(1, -64, 0, 4),
        BackgroundTransparency = 1,
        Text = tostring(opt.value),
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextColor3 = T.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, wrapper)

    local trackBg = make("Frame", {
        Size = UDim2.new(1, -20, 0, TRACK),
        Position = UDim2.new(0, 10, 0, 38),
        BackgroundColor3 = T.surface3,
    }, wrapper)
    corner(TRACK, trackBg)

    local pct0 = (opt.value - opt.min) / (opt.max - opt.min)
    local fill = make("Frame", { Size = UDim2.new(pct0, 0, 1, 0), BackgroundColor3 = T.accent }, trackBg)
    corner(TRACK, fill)

    local TS = 14
    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(pct0, 0, 0.5, 0),
        Size = UDim2.new(0, TS, 0, TS),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 2,
    }, trackBg)
    corner(TS / 2, thumb)

    local sliding = false

    local function setValue(v)
        local r = math.floor(v / opt.float + 0.5) * opt.float
        r = math.clamp(r, opt.min, opt.max)
        opt.value = r
        MorLib.flags[opt.flag] = r
        local p = (r - opt.min) / (opt.max - opt.min)
        fill.Size          = UDim2.new(p, 0, 1, 0)
        thumb.Position     = UDim2.new(p, 0, 0.5, 0)
        valLbl.Text        = tostring(r)
        pcall(opt.callback, r)
    end

    function opt:SetValue(v) setValue(v) end

    local function fromMouse(x)
        local p = math.clamp((x - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        setValue(opt.min + p * (opt.max - opt.min))
    end

    trackBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            tw(thumb, { Size = UDim2.new(0, TS + 4, 0, TS + 4), BackgroundColor3 = T.accentLight }, 0.12)
            fromMouse(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            fromMouse(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and sliding then
            sliding = false
            tw(thumb, { Size = UDim2.new(0, TS, 0, TS), BackgroundColor3 = Color3.new(1,1,1) }, 0.12)
        end
    end)
end

-- ── Dropdown ──────────────────────────────────────────────
local function renderList(opt, parent)
    local ROW_H = 54

    local wrapper = make("Frame", {
        Size = UDim2.new(1, 0, 0, ROW_H),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
        ClipsDescendants = false,
    }, parent)

    local box = make("Frame", {
        Size = UDim2.new(1, -16, 0, ROW_H - 10),
        Position = UDim2.new(0, 8, 0, 5),
        BackgroundColor3 = T.surface3,
    }, wrapper)
    corner(7, box)
    uistroke(T.border, 1, box)

    make("TextLabel", {
        Size = UDim2.new(1, -30, 0, 16),
        Position = UDim2.new(0, 10, 0, 6),
        BackgroundTransparency = 1,
        Text = opt.text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, box)

    local valLbl = make("TextLabel", {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 10, 0, 22),
        BackgroundTransparency = 1,
        Text = opt.value,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, box)

    local arrow = make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 20, 0, 20),
        BackgroundTransparency = 1,
        Text = "▾",
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextColor3 = T.textDim,
    }, box)

    -- Inline expand
    local popup = make("Frame", {
        Position = UDim2.new(0, 8, 1, 2),
        Size = UDim2.new(1, -16, 0, 0),
        BackgroundColor3 = T.surface2,
        ClipsDescendants = true,
        ZIndex = 5,
        Visible = false,
    }, wrapper)
    corner(7, popup)
    uistroke(T.borderLight, 1, popup)

    local popLayout = uilayout(popup, 2)
    uipad(4, 4, 4, 4, popup)

    opt._open = false

    local function closeList()
        opt._open = false
        arrow.Text = "▾"
        tw(popup, { Size = UDim2.new(1, -16, 0, 0) }, 0.18)
        task.delay(0.2, function()
            if not opt._open then popup.Visible = false end
        end)
        -- Reset wrapper size
        tw(wrapper, { Size = UDim2.new(1, 0, 0, ROW_H) }, 0.18)
    end

    local function openList()
        opt._open = true
        arrow.Text = "▴"
        popup.Visible = true
        local count   = math.min(#opt.values, 5)
        local popH    = count * 32 + 8
        tw(popup, { Size = UDim2.new(1, -16, 0, popH) }, 0.2, Enum.EasingStyle.Back)
        tw(wrapper, { Size = UDim2.new(1, 0, 0, ROW_H + popH + 4) }, 0.2, Enum.EasingStyle.Back)
    end

    local function addValue(value)
        local item = make("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = T.surface3,
            Text = tostring(value),
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextColor3 = T.text,
            AutoButtonColor = false,
            ZIndex = 5,
        }, popup)
        corner(5, item)

        item.MouseButton1Click:Connect(function()
            opt.value = tostring(value)
            MorLib.flags[opt.flag] = opt.value
            valLbl.Text = opt.value
            pcall(opt.callback, value)
            closeList()
        end)
        item.MouseEnter:Connect(function() tw(item, { BackgroundColor3 = T.accent }, 0.1) end)
        item.MouseLeave:Connect(function() tw(item, { BackgroundColor3 = T.surface3 }, 0.1) end)
    end

    for _, v in ipairs(opt.values) do addValue(tostring(v)) end

    function opt:AddValue(v) addValue(tostring(v)) end
    function opt:SetValue(v)
        self.value = tostring(v)
        MorLib.flags[self.flag] = self.value
        valLbl.Text = self.value
        pcall(self.callback, v)
    end
    function opt:Close() closeList() end

    box.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            if opt._open then closeList() else openList() end
        end
    end)
    box.MouseEnter:Connect(function() uistroke(T.borderLight, 1, box) end)
    box.MouseLeave:Connect(function() uistroke(T.border, 1, box) end)
end

-- ── Bind ──────────────────────────────────────────────────
local BIND_BLACKLIST = {
    Enum.KeyCode.Unknown, Enum.KeyCode.Return, Enum.KeyCode.Escape,
    Enum.KeyCode.Tab, Enum.KeyCode.Backspace, Enum.KeyCode.Delete,
    Enum.KeyCode.CapsLock,
}

local function renderBind(opt, parent)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    make("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = opt.text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local keyBtn = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 58, 0, 22),
        BackgroundColor3 = T.surface3,
        Text = opt.key,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextColor3 = T.text,
        AutoButtonColor = false,
    }, row)
    corner(5, keyBtn)
    uistroke(T.border, 1, keyBtn)

    local binding = false
    local loop

    local function setKey(key)
        binding = false
        opt.key = type(key) == "string" and key or key.Name
        MorLib.flags[opt.flag] = opt.key
        keyBtn.Text = opt.key
        tw(keyBtn, { BackgroundColor3 = T.surface3 }, 0.15)
    end
    function opt:SetKey(k) setKey(k) end

    keyBtn.MouseButton1Click:Connect(function()
        if binding then return end
        binding = true
        keyBtn.Text = "..."
        tw(keyBtn, { BackgroundColor3 = T.accent }, 0.15)
    end)

    UserInputService.InputBegan:Connect(function(i)
        if UserInputService:GetFocusedTextBox() then return end
        if binding then
            if i.KeyCode == Enum.KeyCode.Escape then setKey(opt.key); return end
            local blocked = false
            for _, k in ipairs(BIND_BLACKLIST) do
                if k == i.KeyCode then blocked = true; break end
            end
            if not blocked then setKey(i.KeyCode) end
            return
        end
        if i.KeyCode.Name == opt.key or i.UserInputType.Name == opt.key then
            if opt.hold then
                loop = RunService.Heartbeat:Connect(function() pcall(opt.callback) end)
            else
                task.spawn(pcall, opt.callback)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if (i.KeyCode.Name == opt.key or i.UserInputType.Name == opt.key) and loop then
            loop:Disconnect(); loop = nil
        end
    end)

    keyBtn.MouseEnter:Connect(function() tw(keyBtn, { BackgroundColor3 = T.surface2 }, 0.1) end)
    keyBtn.MouseLeave:Connect(function() tw(keyBtn, { BackgroundColor3 = T.surface3 }, 0.1) end)
end

-- ══════════════════════════════════════════════════════════
-- FOLDER
-- ══════════════════════════════════════════════════════════
local function renderFolder(folder, parent)
    local HEADER = 34

    local card = make("Frame", {
        Size = UDim2.new(1, 0, 0, HEADER),
        BackgroundColor3 = T.surface,
        ClipsDescendants = true,
        LayoutOrder = folder._order or 0,
    }, parent)
    corner(8, card)
    uistroke(T.border, 1, card)

    -- Header
    local header = make("Frame", {
        Size = UDim2.new(1, 0, 0, HEADER),
        BackgroundTransparency = 1,
    }, card)

    -- Accent left bar
    local accentBar = make("Frame", {
        Size = UDim2.new(0, 3, 0, 16),
        Position = UDim2.new(0, 8, 0.5, -8),
        BackgroundColor3 = T.accent,
    }, header)
    corner(2, accentBar)

    make("TextLabel", {
        Size = UDim2.new(1, -36, 1, 0),
        Position = UDim2.new(0, 18, 0, 0),
        BackgroundTransparency = 1,
        Text = folder.title,
        TextSize = 13,
        Font = Enum.Font.GothamSemibold,
        TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, header)

    local arrowLbl = make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 18, 0, 18),
        BackgroundTransparency = 1,
        Text = folder.open and "▴" or "▾",
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextColor3 = T.textDim,
    }, header)

    -- Body
    local body = make("Frame", {
        Position = UDim2.new(0, 0, 0, HEADER),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
    }, card)

    local bodyLayout = uilayout(body, 3)
    uipad(8, 8, 5, 6, body)

    -- Render children
    local order = 0
    for _, opt in ipairs(folder.options) do
        opt._order = order; order += 1
        if opt._type == "toggle"  then renderToggle(opt, body)
        elseif opt._type == "button"  then renderButton(opt, body)
        elseif opt._type == "label"   then renderLabel(opt, body)
        elseif opt._type == "slider"  then renderSlider(opt, body)
        elseif opt._type == "list"    then renderList(opt, body)
        elseif opt._type == "bind"    then renderBind(opt, body)
        end
    end

    local function autoSize()
        local bh = bodyLayout.AbsoluteContentSize.Y + 11
        card:TweenSize(
            folder.open
                and UDim2.new(1, 0, 0, HEADER + bh)
                or  UDim2.new(1, 0, 0, HEADER),
            "Out", "Quint", 0.24, true
        )
    end

    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(autoSize)
    task.defer(autoSize)

    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            folder.open = not folder.open
            arrowLbl.Text = folder.open and "▴" or "▾"
            tw(accentBar, { BackgroundColor3 = folder.open and T.accent or T.textDim }, 0.2)
            autoSize()
        end
    end)
end

