local FOLDER_H = 32

local function renderFolder(folder, parent)
    local card = make("Frame", {
        Size = UDim2.new(1,0,0,FOLDER_H),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,   -- ← hides body content when collapsed
        LayoutOrder = folder._order or 0,
    }, parent)
    stroke(C.hilight, 2, card)

    -- Header (always visible)
    local header = make("Frame", {
        Size = UDim2.new(1,0,0,FOLDER_H),
        BackgroundColor3 = C.panel2,
        BorderSizePixel = 0,
        ZIndex = card.ZIndex + 1,
    }, card)

    -- Left accent bar (3px pixel strip)
    make("Frame", {
        Size = UDim2.new(0,4,0,FOLDER_H),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = header.ZIndex + 1,
    }, header)

    make("TextLabel", {
        Size = UDim2.new(1,-36,1,0),
        Position = UDim2.new(0,10,0,0),
        BackgroundTransparency = 1,
        Text = "[ " .. string.upper(tostring(folder.title or "SECTION")) .. " ]",
        TextSize = FS_LG,
        Font = PX_FONT,
        TextColor3 = C.accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = header.ZIndex + 1,
    }, header)

    local arrowImg = make("ImageLabel", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-6,0.5,0),
        Size = UDim2.new(0,16,0,16),
        BackgroundTransparency = 1,
        Image = ICON.arrow,
        ImageColor3 = C.textDim,
        Rotation = folder.open and 180 or 0,
        ZIndex = header.ZIndex + 1,
    }, header)

    -- Body (content lives here, hidden via ClipsDescendants when collapsed)
    local body = make("Frame", {
        Position = UDim2.new(0,0,0,FOLDER_H),
        Size = UDim2.new(1,0,0,0),
        BackgroundTransparency = 1,
        ZIndex = card.ZIndex + 1,
        Visible = folder.open,   -- initially respect open state
    }, card)

    local bodyLayout = layout(body, 3)
    pad(6,6,5,6,body)

    -- Render children
    local childOrder = 0
    for _, opt in ipairs(folder.options or {}) do
        opt._order = childOrder; childOrder += 1
        if     opt._type == "toggle" then renderToggle(opt, body)
        elseif opt._type == "button" then renderButton(opt, body)
        elseif opt._type == "label"  then renderLabel(opt,  body)
        elseif opt._type == "slider" then renderSlider(opt, body)
        elseif opt._type == "list"   then renderList(opt,   body)
        elseif opt._type == "bind"   then renderBind(opt,   body)
        end
    end

    local bodyH = 0
    local function refreshCardSize()
        bodyH = bodyLayout.AbsoluteContentSize.Y + 11
        card.Size = UDim2.new(1,0,0, folder.open and (FOLDER_H + bodyH) or FOLDER_H)
    end
    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        task.defer(refreshCardSize)
    end)
    task.defer(refreshCardSize)

    local fDebounce = false
    header.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if fDebounce then return end
        fDebounce = true

        folder.open = not folder.open
        arrowImg.Rotation = folder.open and 180 or 0

        if folder.open then
            body.Visible = true
            card:TweenSize(UDim2.new(1,0,0, FOLDER_H + bodyH), "Out", "Linear", 0.18, true)
        else
            -- Tween first, then hide body so ClipsDescendants clips during animation
            card:TweenSize(UDim2.new(1,0,0, FOLDER_H), "Out", "Linear", 0.18, true)
            task.delay(0.19, function()
                if not folder.open then body.Visible = false end
            end)
        end

        task.wait(0.22)
        fDebounce = false
    end)

    header.MouseEnter:Connect(function() header.BackgroundColor3 = C.panel3 end)
    header.MouseLeave:Connect(function() header.BackgroundColor3 = C.panel2 end)
end

-- ══════════════════════════════════════════════════════════
-- WINDOW RENDERER
-- ══════════════════════════════════════════════════════════
local WIN_W    = 262
local TITLE_H  = 38
local MAX_WIN_H = 500

local function renderWindow(win, gui)
    local startX = math.floor((gui.AbsoluteSize.X - WIN_W) / 2)
    local startY = 52

    -- Drop shadow (pixel offset square)
    local shadow = make("Frame", {
        Size = UDim2.new(0, WIN_W+6, 0, TITLE_H+6),
        Position = UDim2.new(0, startX+4, 0, startY+4),
        BackgroundColor3 = C.shadow,
        BorderSizePixel = 0,
        ZIndex = 0,
    }, gui)
    win._shadow = shadow

    -- Main window frame
    local main = make("Frame", {
        Size = UDim2.new(0, WIN_W, 0, TITLE_H),
        Position = UDim2.new(0, startX, 0, startY),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0,
        ClipsDescendants = true,   -- ← KEY: hides everything below titlebar when minimized
        ZIndex = 1,
    }, gui)
    stroke(C.hilight, 2, main)
    win.main = main

    -- ── Title bar ─────────────────────────────────────────
    local titleBar = make("Frame", {
        Size = UDim2.new(1,0,0,TITLE_H),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, main)

    -- Bottom border on titlebar
    make("Frame", {
        AnchorPoint = Vector2.new(0,1),
        Position = UDim2.new(0,0,1,0),
        Size = UDim2.new(1,0,0,2),
        BackgroundColor3 = C.shadow,
        BorderSizePixel = 0,
        ZIndex = titleBar.ZIndex + 1,
    }, titleBar)

    -- Icon block (pixel M logo)
    local logoBlock = make("Frame", {
        Size = UDim2.new(0,28,0,28),
        Position = UDim2.new(0,4,0,5),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = titleBar.ZIndex + 1,
    }, titleBar)
    stroke(C.shadow, 2, logoBlock)
    make("TextLabel", {
        Size = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text = "M",
        TextSize = 16,
        Font = PX_FONT,
        TextColor3 = C.shadow,
        ZIndex = logoBlock.ZIndex + 1,
    }, logoBlock)

    make("TextLabel", {
        Size = UDim2.new(1,-68,1,0),
        Position = UDim2.new(0,38,0,0),
        BackgroundTransparency = 1,
        Text = string.upper(tostring(win.title or "WINDOW")),
        TextSize = FS_LG,
        Font = PX_FONT,
        TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = titleBar.ZIndex + 1,
    }, titleBar)

    -- Minimize button
    local minBtn = make("TextButton", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-4,0.5,0),
        Size = UDim2.new(0,28,0,26),
        BackgroundColor3 = C.panel2,
        Text = "-",
        TextSize = 18,
        Font = PX_FONT,
        TextColor3 = C.textDim,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = titleBar.ZIndex + 2,
    }, titleBar)
    stroke(C.shadow, 2, minBtn)

    -- ── Content scroll ────────────────────────────────────
    local scroll = make("ScrollingFrame", {
        Position = UDim2.new(0,0,0,TITLE_H),
        Size = UDim2.new(1,0,1,-TITLE_H),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = C.accent,
        CanvasSize = UDim2.new(0,0,0,0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ZIndex = 2,
        Visible = true,
    }, main)

    local contentFrame = make("Frame", {
        Size = UDim2.new(1,0,0,0),
        BackgroundTransparency = 1,
        ZIndex = 2,
    }, scroll)

    local contentLayout = layout(contentFrame, 5)
    pad(5,5,5,8,contentFrame)

    -- Render folders / bare options
    local childOrder = 0
    for _, opt in ipairs(win.options or {}) do
        opt._order = childOrder; childOrder += 1
        if     opt._type == "folder" then renderFolder(opt, contentFrame)
        elseif opt._type == "toggle" then renderToggle(opt, contentFrame)
        elseif opt._type == "button" then renderButton(opt, contentFrame)
        elseif opt._type == "label"  then renderLabel(opt,  contentFrame)
        elseif opt._type == "slider" then renderSlider(opt, contentFrame)
        elseif opt._type == "list"   then renderList(opt,   contentFrame)
        elseif opt._type == "bind"   then renderBind(opt,   contentFrame)
        end
    end

    -- Auto-fit window height
    local function autoSize()
        local h     = contentLayout.AbsoluteContentSize.Y + 14
        local winH  = math.min(h + TITLE_H, MAX_WIN_H)
        contentFrame.Size  = UDim2.new(1,0,0,h)
        scroll.CanvasSize  = UDim2.new(0,0,0,h)
        if win.open then
            main.Size   = UDim2.new(0,WIN_W,0,winH)
            shadow.Size = UDim2.new(0,WIN_W+6,0,winH+6)
        end
    end
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        task.defer(autoSize)
    end)
    task.defer(autoSize)

    -- ── Minimize ──────────────────────────────────────────
    local minDebounce = false
    minBtn.MouseButton1Click:Connect(function()
        if minDebounce then return end
        minDebounce = true

        win.open = not win.open

        if win.open then
            -- Expand: show scroll first, then tween
            scroll.Visible = true
            minBtn.Text = "-"
            minBtn.TextColor3 = C.textDim
            local h     = contentLayout.AbsoluteContentSize.Y + 14
            local winH  = math.min(h + TITLE_H, MAX_WIN_H)
            main:TweenSize(UDim2.new(0,WIN_W,0,winH), "Out","Linear",0.2,true)
            shadow:TweenSize(UDim2.new(0,WIN_W+6,0,winH+6),"Out","Linear",0.2,true)
        else
            -- Collapse: tween first, then hide scroll
            -- ClipsDescendants hides content during animation
            minBtn.Text = "+"
            minBtn.TextColor3 = C.accent
            main:TweenSize(UDim2.new(0,WIN_W,0,TITLE_H),"Out","Linear",0.2,true)
            shadow:TweenSize(UDim2.new(0,WIN_W+6,0,TITLE_H+6),"Out","Linear",0.2,true)
            task.delay(0.21, function()
                if not win.open then
                    scroll.Visible = false  -- fully prevent any rendering
                end
            end)
        end

        task.wait(0.25)
        minDebounce = false
    end)

    minBtn.MouseEnter:Connect(function()
        minBtn.BackgroundColor3 = win.open and C.red or C.accentD
    end)
    minBtn.MouseLeave:Connect(function()
        minBtn.BackgroundColor3 = C.panel2
    end)

    -- ── Drag ──────────────────────────────────────────────
    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            _drag.on     = true
            _drag.obj    = main
            _drag.shadow = shadow
            _drag.start  = i.Position
            _drag.spos   = main.Position
        end
    end)
end

-- ══════════════════════════════════════════════════════════
-- API  —  METHOD INJECTOR
-- ══════════════════════════════════════════════════════════
local function injectMethods(t)
    t.options = t.options or {}

    function t:AddFolder(title)
        local f = { _type="folder", title=title or "Section", options={}, open=true }
        injectMethods(f)
        table.insert(self.options, f)
        return f
    end

    function t:AddToggle(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type    = "toggle"
        opt.text     = opt.text  or "Toggle"
        opt.state    = opt.state == true
        opt.flag     = opt.flag  or opt.text
        opt.callback = type(opt.callback)=="function" and opt.callback or function()end
        MorLib.flags[opt.flag] = opt.state
        table.insert(self.options, opt)
        return opt
    end

    function t:AddButton(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type    = "button"
        opt.text     = opt.text or "Button"
        opt.flag     = opt.flag or opt.text
        opt.callback = type(opt.callback)=="function" and opt.callback or function()end
        table.insert(self.options, opt)
        return opt
    end

    function t:AddLabel(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type = "label"
        opt.text  = opt.text or ""
        table.insert(self.options, opt)
        return opt
    end

    function t:AddSlider(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type    = "slider"
        opt.text     = opt.text  or "Slider"
        opt.min      = tonumber(opt.min)   or 0
        opt.max      = tonumber(opt.max)   or 100
        opt.float    = tonumber(opt.float) or 1
        opt.value    = math.clamp(tonumber(opt.value) or opt.min, opt.min, opt.max)
        opt.flag     = opt.flag or opt.text
        opt.callback = type(opt.callback)=="function" and opt.callback or function()end
        MorLib.flags[opt.flag] = opt.value
        table.insert(self.options, opt)
        return opt
    end

    function t:AddList(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type    = "list"
        opt.text     = opt.text   or "Dropdown"
        opt.values   = type(opt.values)=="table" and opt.values or {}
        opt.value    = tostring(opt.value or opt.values[1] or "")
        opt.flag     = opt.flag   or opt.text
        opt.callback = type(opt.callback)=="function" and opt.callback or function()end
        MorLib.flags[opt.flag] = opt.value
        table.insert(self.options, opt)
        return opt
    end

    function t:AddBind(opt)
        opt = type(opt)=="table" and opt or {}
        opt._type    = "bind"
        opt.text     = opt.text or "Bind"
        opt.key      = type(opt.key)=="string"   and opt.key
                    or type(opt.key)=="userdata"  and opt.key.Name
                    or "F"
        opt.hold     = opt.hold == true
        opt.flag     = opt.flag or opt.text
        opt.callback = type(opt.callback)=="function" and opt.callback or function()end
        MorLib.flags[opt.flag] = opt.key
        table.insert(self.options, opt)
        return opt
    end
end

-- ══════════════════════════════════════════════════════════
-- PUBLIC
-- ══════════════════════════════════════════════════════════
function MorLib:CreateWindow(title)
    local win = { _type="window", title=title or "Window", options={}, open=true, _inited=false }
    injectMethods(win)
    table.insert(self.windows, win)
    return win
end

function MorLib:Init()
    local gui = Instance.new("ScreenGui")
    gui.Name           = "MorLib"
    gui.ResetOnSpawn   = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    if syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = game:GetService("CoreGui")
    elseif gethui then
        gui.Parent = gethui()
    elseif get_hidden_gui then
        gui.Parent = get_hidden_gui()
    else
        pcall(function() gui.Parent = game:GetService("CoreGui") end)
    end

    self.gui = gui
    for _, win in ipairs(self.windows) do
        if not win._inited then
            win._inited = true
            renderWindow(win, gui)
        end
    end
    return gui
end

-- Hide/show all windows (RightControl default)
function MorLib:Toggle()
    self.open = not self.open
    for _, win in ipairs(self.windows) do
        if win.main   then win.main.Visible   = self.open end
        if win._shadow then win._shadow.Visible = self.open end
    end
end

UserInputService.InputBegan:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.RightControl then
        MorLib:Toggle()
    end
end)

return MorLib
