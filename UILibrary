-- ══════════════════════════════════════════════════════════
-- CORE HELPERS
-- ══════════════════════════════════════════════════════════
local function make(class, props, parent)
    local ok, inst = pcall(Instance.new, class)
    if not ok then return nil end
    for k, v in pairs(props or {}) do
        pcall(function() inst[k] = v end)
    end
    if parent then inst.Parent = parent end
    return inst
end

local function tw(obj, props, t)
    if not obj or not obj.Parent then return end
    TweenService:Create(obj,
        TweenInfo.new(t or 0.15, Enum.EasingStyle.Linear),
        props):Play()
end

local function stroke(color, thick, parent)
    return make("UIStroke", {
        Color     = color or C.shadow,
        Thickness = thick or 2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function pad(l, r, t, b, parent)
    make("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, parent)
end

local function layout(parent, spacing)
    local l = make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, spacing or 2),
    }, parent)
    return l
end

-- Pixel "sunken" box (dark top/left, bright bottom/right = pressed look)
local function pixelBox(parent, size, pos, col, zIdx)
    local f = make("Frame", {
        Size            = size,
        Position        = pos,
        BackgroundColor3 = col or C.panel2,
        BorderSizePixel = 0,
        ZIndex          = zIdx or 1,
    }, parent)
    -- top highlight
    make("Frame", { Size = UDim2.new(1,0,0,2), BackgroundColor3 = C.hilight,
        BorderSizePixel = 0, ZIndex = f.ZIndex+1 }, f)
    -- left highlight
    make("Frame", { Size = UDim2.new(0,2,1,0), BackgroundColor3 = C.hilight,
        BorderSizePixel = 0, ZIndex = f.ZIndex+1 }, f)
    -- bottom shadow
    make("Frame", { AnchorPoint = Vector2.new(0,1), Position = UDim2.new(0,0,1,0),
        Size = UDim2.new(1,0,0,2), BackgroundColor3 = C.shadow,
        BorderSizePixel = 0, ZIndex = f.ZIndex+1 }, f)
    -- right shadow
    make("Frame", { AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,0,0,0),
        Size = UDim2.new(0,2,1,0), BackgroundColor3 = C.shadow,
        BorderSizePixel = 0, ZIndex = f.ZIndex+1 }, f)
    return f
end

-- ── Drag system ───────────────────────────────────────────
local _drag = { on = false }

UserInputService.InputChanged:Connect(function(i)
    if not _drag.on then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local d = i.Position - _drag.start
    _drag.obj.Position = UDim2.new(
        _drag.spos.X.Scale, _drag.spos.X.Offset + d.X,
        _drag.spos.Y.Scale, math.max(0, _drag.spos.Y.Offset + d.Y)
    )
    -- sync shadow
    if _drag.shadow then
        _drag.shadow.Position = UDim2.new(
            _drag.obj.Position.X.Scale, _drag.obj.Position.X.Offset + 4,
            _drag.obj.Position.Y.Scale, _drag.obj.Position.Y.Offset + 4
        )
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        _drag.on = false
    end
end)

