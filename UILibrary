    -- Content
    local content = make("Frame", {
        Position = UDim2.new(0, 0, 0, TITLE_H),
        Size = UDim2.new(1, 0, 1, -TITLE_H),
        BackgroundTransparency = 1,
    }, main)

    local contentLayout = uilayout(content, 6)
    uipad(8, 8, 8, 10, content)

    -- Render options / folders
    local order = 0
    for _, opt in ipairs(win.options) do
        opt._order = order; order += 1
        if opt._type == "folder"  then renderFolder(opt, content)
        elseif opt._type == "toggle"  then renderToggle(opt, content)
        elseif opt._type == "button"  then renderButton(opt, content)
        elseif opt._type == "label"   then renderLabel(opt, content)
        elseif opt._type == "slider"  then renderSlider(opt, content)
        elseif opt._type == "list"    then renderList(opt, content)
        elseif opt._type == "bind"    then renderBind(opt, content)
        end
    end

    local function autoSize()
        local h = contentLayout.AbsoluteContentSize.Y + 18
        main:TweenSize(
            win.open
                and UDim2.new(0, WIN_W, 0, TITLE_H + h)
                or  UDim2.new(0, WIN_W, 0, TITLE_H),
            "Out", "Quint", 0.28, true
        )
    end

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(autoSize)
    task.defer(autoSize)

    minBtn.MouseButton1Click:Connect(function()
        win.open = not win.open
        minBtn.Text = win.open and "−" or "+"
        autoSize()
    end)

    -- Drag
    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging     = true
            dragObj      = main
            dragStart    = i.Position
            dragStartPos = main.Position
        end
    end)

    minBtn.MouseEnter:Connect(function() tw(minBtn, { BackgroundColor3 = T.red }, 0.1) end)
    minBtn.MouseLeave:Connect(function() tw(minBtn, { BackgroundColor3 = T.surface3 }, 0.1) end)
end

-- ══════════════════════════════════════════════════════════
-- API — METHOD INJECTOR
-- ══════════════════════════════════════════════════════════
local function injectMethods(t)
    function t:AddFolder(title)
        local f = { _type = "folder", title = title or "Section", options = {}, open = true }
        injectMethods(f)
        table.insert(t.options, f)
        return f
    end

    function t:AddToggle(opt)
        opt = opt or {}
        opt._type = "toggle"
        opt.text  = tostring(opt.text or "Toggle")
        opt.state = opt.state == true
        opt.flag  = opt.flag or opt.text
        opt.callback = type(opt.callback) == "function" and opt.callback or function() end
        MorLib.flags[opt.flag] = opt.state
        table.insert(t.options, opt)
        return opt
    end

    function t:AddButton(opt)
        opt = opt or {}
        opt._type = "button"
        opt.text  = tostring(opt.text or "Button")
        opt.flag  = opt.flag or opt.text
        opt.callback = type(opt.callback) == "function" and opt.callback or function() end
        table.insert(t.options, opt)
        return opt
    end

    function t:AddLabel(opt)
        opt = opt or {}
        opt._type = "label"
        opt.text  = tostring(opt.text or "")
        table.insert(t.options, opt)
        return opt
    end

    function t:AddSlider(opt)
        opt = opt or {}
        opt._type  = "slider"
        opt.text   = tostring(opt.text or "Slider")
        opt.min    = tonumber(opt.min)   or 0
        opt.max    = tonumber(opt.max)   or 100
        opt.value  = math.clamp(tonumber(opt.value) or opt.min, opt.min, opt.max)
        opt.float  = tonumber(opt.float) or 1
        opt.flag   = opt.flag or opt.text
        opt.callback = type(opt.callback) == "function" and opt.callback or function() end
        MorLib.flags[opt.flag] = opt.value
        table.insert(t.options, opt)
        return opt
    end

    function t:AddList(opt)
        opt = opt or {}
        opt._type  = "list"
        opt.text   = tostring(opt.text or "Dropdown")
        opt.values = type(opt.values) == "table" and opt.values or {}
        opt.value  = tostring(opt.value or opt.values[1] or "")
        opt.flag   = opt.flag or opt.text
        opt.callback = type(opt.callback) == "function" and opt.callback or function() end
        MorLib.flags[opt.flag] = opt.value
        table.insert(t.options, opt)
        return opt
    end

    function t:AddBind(opt)
        opt = opt or {}
        opt._type = "bind"
        opt.text  = tostring(opt.text or "Bind")
        opt.key   = (opt.key and (type(opt.key) == "string" and opt.key or opt.key.Name)) or "F"
        opt.hold  = opt.hold == true
        opt.flag  = opt.flag or opt.text
        opt.callback = type(opt.callback) == "function" and opt.callback or function() end
        MorLib.flags[opt.flag] = opt.key
        table.insert(t.options, opt)
        return opt
    end
end

function MorLib:CreateWindow(title)
    local win = {
        _type   = "window",
        title   = tostring(title or "Window"),
        options = {},
        open    = true,
        _init   = false,
    }
    injectMethods(win)
    table.insert(self.windows, win)
    return win
end

function MorLib:Init()
    local gui = Instance.new("ScreenGui")
    gui.Name           = "MorLib"
    gui.ResetOnSpawn   = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    if syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = game:GetService("CoreGui")
    elseif gethui then
        gui.Parent = gethui()
    elseif get_hidden_gui then
        gui.Parent = get_hidden_gui()
    else
        pcall(function() gui.Parent = game:GetService("CoreGui") end)
    end

    self.gui = gui
    for _, win in ipairs(self.windows) do
        if not win._init then
            win._init = true
            renderWindow(win, gui)
        end
    end
    return gui
end

function MorLib:Close()
    self.open = not self.open
    for _, win in ipairs(self.windows) do
        if win.main then win.main.Visible = self.open end
    end
end

return MorLib
