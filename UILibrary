-- ═══════════════════════════════════════════════════════════
-- SLIDER
-- ═══════════════════════════════════════════════════════════

local function RenderSlider(opt,parent)

    local Holder = Make("Frame", {
        Size = UDim2.new(1,0,0,56),
        BackgroundColor3 = C.panel
    }, parent)

    Corner(Holder,6)
    Stroke(Holder)

    local Title = Make("TextLabel", {
        BackgroundTransparency = 1,

        Position = UDim2.new(0,12,0,0),
        Size = UDim2.new(1,-60,0,24),

        Font = FONT,
        Text = opt.text,
        TextColor3 = C.text,
        TextSize = TEXT_SIZE,

        TextXAlignment = Enum.TextXAlignment.Left
    }, Holder)

    local Value = Make("TextLabel", {
        BackgroundTransparency = 1,

        Position = UDim2.new(1,-50,0,0),
        Size = UDim2.new(0,40,0,24),

        Font = FONT,
        Text = tostring(opt.value),
        TextColor3 = C.accent,
        TextSize = SMALL_SIZE
    }, Holder)

    local Bar = Make("Frame", {
        Position = UDim2.new(0,12,1,-18),
        Size = UDim2.new(1,-24,0,8),

        BackgroundColor3 = C.panel2
    }, Holder)

    Corner(Bar,4)

    local Fill = Make("Frame", {
        Size = UDim2.new(0,0,1,0),
        BackgroundColor3 = C.accent
    }, Bar)

    Corner(Fill,4)

    local dragging = false

    local function Set(x)

        local percent = math.clamp(
            (x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
            0,
            1
        )

        local value = math.floor(
            ((opt.max - opt.min) * percent) + opt.min
        )

        opt.value = value

        Fill.Size = UDim2.new(percent,0,1,0)

        Value.Text = tostring(value)

        MorLib.flags[opt.flag] = value

        pcall(opt.callback,value)
    end

    Bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Set(i.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            Set(i.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- DROPDOWN
-- ═══════════════════════════════════════════════════════════

local function RenderDropdown(opt,parent)

    local Holder = Make("Frame", {
        Size = UDim2.new(1,0,0,42),
        BackgroundColor3 = C.panel,
        ClipsDescendants = true
    }, parent)

    Corner(Holder,6)
    Stroke(Holder)

    local Open = false

    local Main = Make("TextButton", {
        Size = UDim2.new(1,0,0,42),

        BackgroundTransparency = 1,
        AutoButtonColor = false,

        Font = FONT,
        Text = opt.text.." : "..opt.value,
        TextColor3 = C.text,
        TextSize = TEXT_SIZE
    }, Holder)

    local Container = Make("Frame", {
        Position = UDim2.new(0,0,0,42),
        Size = UDim2.new(1,0,0,0),

        BackgroundTransparency = 1
    }, Holder)

    local UIList = Layout(Container,4)

    Padding(Container,4)

    local function Refresh()

        local count = #opt.values
        local size = count * 34

        Tween(Holder,{
            Size = Open and
                UDim2.new(1,0,0,42 + size + 8)
                or
                UDim2.new(1,0,0,42)
        })

        Tween(Container,{
            Size = Open and
                UDim2.new(1,0,0,size)
                or
                UDim2.new(1,0,0,0)
        })
    end

    for _,v in ipairs(opt.values) do

        local Btn = Make("TextButton", {
            Size = UDim2.new(1,0,0,30),

            BackgroundColor3 = C.panel2,
            AutoButtonColor = false,

            Font = FONT,
            Text = tostring(v),
            TextColor3 = C.text,
            TextSize = SMALL_SIZE
        }, Container)

        Corner(Btn,4)

        Btn.MouseButton1Click:Connect(function()

            opt.value = tostring(v)

            Main.Text = opt.text.." : "..opt.value

            MorLib.flags[opt.flag] = v

            pcall(opt.callback,v)

            Open = false
            Refresh()
        end)
    end

    Main.MouseButton1Click:Connect(function()
        Open = not Open
        Refresh()
    end)
end

-- ═══════════════════════════════════════════════════════════
-- FOLDER
-- ═══════════════════════════════════════════════════════════

local function RenderFolder(folder,parent)

    local Holder = Make("Frame", {
        Size = UDim2.new(1,0,0,44),
        BackgroundColor3 = C.panel2,
        ClipsDescendants = true
    }, parent)

    Corner(Holder,6)
    Stroke(Holder)

    local Open = true

    local Top = Make("TextButton", {
        Size = UDim2.new(1,0,0,44),

        BackgroundTransparency = 1,
        AutoButtonColor = false,

        Font = FONT,
        Text = folder.title,
        TextColor3 = C.accent,
        TextSize = TITLE_SIZE
    }, Holder)

    local Container = Make("Frame", {
        Position = UDim2.new(0,8,0,48),
        Size = UDim2.new(1,-16,0,0),

        BackgroundTransparency = 1
    }, Holder)

    local UIList = Layout(Container,6)

    local function Resize()

        local content = UIList.AbsoluteContentSize.Y

        Tween(Container,{
            Size = UDim2.new(1,-16,0,Open and content or 0)
        })

        Tween(Holder,{
            Size = UDim2.new(1,0,0,
                Open and content + 58 or 44
            )
        })
    end

    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(Resize)

    task.defer(Resize)

    Top.MouseButton1Click:Connect(function()
        Open = not Open
        Resize()
    end)

    -- render options

    for _,opt in ipairs(folder.options) do

        if opt._type == "toggle" then
            RenderToggle(opt,Container)

        elseif opt._type == "button" then
            RenderButton(opt,Container)

        elseif opt._type == "label" then
            RenderLabel(opt,Container)

        elseif opt._type == "slider" then
            RenderSlider(opt,Container)

        elseif opt._type == "list" then
            RenderDropdown(opt,Container)
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- WINDOW
-- ═══════════════════════════════════════════════════════════

local function RenderWindow(win,gui)

    local Main = Make("Frame", {
        Size = UDim2.new(0,320,0,420),
        Position = UDim2.new(0.5,-160,0.5,-210),

        BackgroundColor3 = C.bg
    }, gui)

    Corner(Main,8)
    Stroke(Main)

    local Top = Make("Frame", {
        Size = UDim2.new(1,0,0,46),
        BackgroundColor3 = C.topbar
    }, Main)

    Corner(Top,8)

    local Fix = Make("Frame", {
        Position = UDim2.new(0,0,1,-8),
        Size = UDim2.new(1,0,0,8),
        BackgroundColor3 = C.topbar,
        BorderSizePixel = 0
    }, Top)

    local Title = Make("TextLabel", {
        BackgroundTransparency = 1,

        Size = UDim2.new(1,0,1,0),

        Font = FONT,
        Text = win.title,
        TextColor3 = C.text,
        TextSize = TITLE_SIZE
    }, Top)

    local Scroll = Make("ScrollingFrame", {
        Position = UDim2.new(0,10,0,56),
        Size = UDim2.new(1,-20,1,-66),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(0,0,0,0)
    }, Main)

    local Container = Make("Frame", {
        Size = UDim2.new(1,0,0,0),
        BackgroundTransparency = 1
    }, Scroll)

    local UIList = Layout(Container,8)

    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()

        Container.Size = UDim2.new(
            1,
            0,
            0,
            UIList.AbsoluteContentSize.Y
        )

        Scroll.CanvasSize = UDim2.new(
            0,
            0,
            0,
            UIList.AbsoluteContentSize.Y + 10
        )
    end)

    for _,opt in ipairs(win.options) do

        if opt._type == "folder" then
            RenderFolder(opt,Container)

        elseif opt._type == "toggle" then
            RenderToggle(opt,Container)

        elseif opt._type == "button" then
            RenderButton(opt,Container)

        elseif opt._type == "label" then
            RenderLabel(opt,Container)

        elseif opt._type == "slider" then
            RenderSlider(opt,Container)

        elseif opt._type == "list" then
            RenderDropdown(opt,Container)
        end
    end

    -- DRAG

    local dragging = false
    local dragStart
    local startPos

    Top.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)

        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,

                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- METHODS
-- ═══════════════════════════════════════════════════════════

local function Inject(tab)

    tab.options = {}

    function tab:AddFolder(title)

        local folder = {
            _type = "folder",
            title = title,
            options = {}
        }

        Inject(folder)

        table.insert(self.options,folder)

        return folder
    end

    function tab:AddToggle(opt)

        opt._type = "toggle"

        opt.state = opt.state or false

        table.insert(self.options,opt)

        return opt
    end

    function tab:AddButton(opt)

        opt._type = "button"

        table.insert(self.options,opt)

        return opt
    end

    function tab:AddLabel(opt)

        opt._type = "label"

        table.insert(self.options,opt)

        return opt
    end

    function tab:AddSlider(opt)

        opt._type = "slider"

        table.insert(self.options,opt)

        return opt
    end

    function tab:AddList(opt)

        opt._type = "list"

        table.insert(self.options,opt)

        return opt
    end
end

-- ═══════════════════════════════════════════════════════════
-- PUBLIC API
-- ═══════════════════════════════════════════════════════════

function MorLib:CreateWindow(title)

    local win = {
        title = title,
        options = {}
    }

    Inject(win)

    table.insert(self.windows,win)

    return win
end

function MorLib:Init()

    local GUI = Make("ScreenGui",{
        Name = "MorLib",
        ResetOnSpawn = false
    }, game:GetService("CoreGui"))

    for _,win in ipairs(self.windows) do
        RenderWindow(win,GUI)
    end

    self.gui = GUI

    return GUI
end

return MorLib
