-- ═══════════════════════════════════════════════════════════
-- MORLIB
-- ═══════════════════════════════════════════════════════════

local MorLib = {
    flags = {},
    windows = {},
    open = true
}

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- ═══════════════════════════════════════════════════════════
-- PIXEL COLORS
-- ═══════════════════════════════════════════════════════════

local C = {
    bg          = Color3.fromRGB(26,26,30),
    topbar      = Color3.fromRGB(45,45,52),

    panel       = Color3.fromRGB(38,38,44),
    panel2      = Color3.fromRGB(48,48,58),
    panelHover  = Color3.fromRGB(58,58,70),

    accent      = Color3.fromRGB(255,170,60),
    accentDark  = Color3.fromRGB(200,120,30),

    text        = Color3.fromRGB(245,245,245),
    textDark    = Color3.fromRGB(180,180,180),

    stroke      = Color3.fromRGB(14,14,18),
    shadow      = Color3.fromRGB(0,0,0),
}

-- FONTE MAIS "ARCADE"
local FONT = Enum.Font.Arcade

local TITLE_SIZE = 18
local TEXT_SIZE  = 15
local SMALL_SIZE = 13

-- ═══════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════

local function Make(class, props, parent)
    local obj = Instance.new(class)

    for i,v in pairs(props or {}) do
        obj[i] = v
    end

    if parent then
        obj.Parent = parent
    end

    return obj
end

local function Stroke(obj, color, thickness)
    return Make("UIStroke", {
        Color = color or C.stroke,
        Thickness = thickness or 2
    }, obj)
end

local function Corner(obj, radius)
    return Make("UICorner", {
        CornerRadius = UDim.new(0, radius or 4)
    }, obj)
end

local function Padding(parent, px)
    return Make("UIPadding", {
        PaddingTop = UDim.new(0, px),
        PaddingBottom = UDim.new(0, px),
        PaddingLeft = UDim.new(0, px),
        PaddingRight = UDim.new(0, px),
    }, parent)
end

local function Layout(parent, spacing)
    return Make("UIListLayout", {
        Padding = UDim.new(0, spacing),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, parent)
end

local function Tween(obj, props, time)
    TweenService:Create(
        obj,
        TweenInfo.new(time or 0.12, Enum.EasingStyle.Quad),
        props
    ):Play()
end

-- ═══════════════════════════════════════════════════════════
-- TOGGLE
-- ═══════════════════════════════════════════════════════════

local function RenderToggle(opt, parent)

    local Holder = Make("TextButton", {
        Size = UDim2.new(1,0,0,42),
        BackgroundColor3 = C.panel,
        AutoButtonColor = false,
        Text = ""
    }, parent)

    Corner(Holder, 6)
    Stroke(Holder)

    local Title = Make("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0,14,0,0),
        Size = UDim2.new(1,-70,1,0),

        Font = FONT,
        Text = opt.text,
        TextColor3 = C.text,
        TextSize = TEXT_SIZE,

        TextXAlignment = Enum.TextXAlignment.Left
    }, Holder)

    local ToggleBG = Make("Frame", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-14,0.5,0),

        Size = UDim2.new(0,42,0,22),

        BackgroundColor3 = opt.state and C.accent or C.panel2
    }, Holder)

    Corner(ToggleBG, 5)
    Stroke(ToggleBG)

    local Ball = Make("Frame", {
        Size = UDim2.new(0,16,0,16),
        Position = opt.state and
            UDim2.new(1,-18,0.5,-8)
            or
            UDim2.new(0,2,0.5,-8),

        BackgroundColor3 = Color3.fromRGB(255,255,255)
    }, ToggleBG)

    Corner(Ball, 4)

    local function Set(v)
        opt.state = v
        MorLib.flags[opt.flag] = v

        Tween(ToggleBG,{
            BackgroundColor3 = v and C.accent or C.panel2
        })

        Tween(Ball,{
            Position = v and
                UDim2.new(1,-18,0.5,-8)
                or
                UDim2.new(0,2,0.5,-8)
        })

        pcall(opt.callback,v)
    end

    Holder.MouseButton1Click:Connect(function()
        Set(not opt.state)
    end)

    Holder.MouseEnter:Connect(function()
        Tween(Holder,{
            BackgroundColor3 = C.panelHover
        })
    end)

    Holder.MouseLeave:Connect(function()
        Tween(Holder,{
            BackgroundColor3 = C.panel
        })
    end)

    function opt:Set(v)
        Set(v)
    end
end

-- ═══════════════════════════════════════════════════════════
-- BUTTON
-- ═══════════════════════════════════════════════════════════

local function RenderButton(opt,parent)

    local Btn = Make("TextButton", {
        Size = UDim2.new(1,0,0,42),

        BackgroundColor3 = C.panel,
        AutoButtonColor = false,

        Font = FONT,
        Text = opt.text,
        TextColor3 = C.text,
        TextSize = TEXT_SIZE
    }, parent)

    Corner(Btn,6)
    Stroke(Btn)

    Btn.MouseEnter:Connect(function()
        Tween(Btn,{
            BackgroundColor3 = C.accent
        })

        Tween(Btn,{
            TextColor3 = Color3.new(0,0,0)
        })
    end)

    Btn.MouseLeave:Connect(function()
        Tween(Btn,{
            BackgroundColor3 = C.panel
        })

        Tween(Btn,{
            TextColor3 = C.text
        })
    end)

    Btn.MouseButton1Click:Connect(function()
        pcall(opt.callback)
    end)
end

