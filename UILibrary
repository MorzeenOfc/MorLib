-- ── Label ─────────────────────────────────────────────────
local function renderLabel(opt, parent)
    local row = make("Frame", {
        Size = UDim2.new(1,0,0,20),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    local lbl = make("TextLabel", {
        Size = UDim2.new(1,-8,1,0),
        Position = UDim2.new(0,4,0,0),
        BackgroundTransparency = 1,
        Text = ">> " .. string.upper(tostring(opt.text or "")),
        TextSize = FS_SM,
        Font = PX_FONT,
        TextColor3 = C.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    function opt:SetText(v)
        lbl.Text = ">> " .. string.upper(tostring(v))
    end
    setmetatable(opt, {
        __newindex = function(t, k, v)
            if k == "Text" then
                lbl.Text = ">> " .. string.upper(tostring(v))
            end
            rawset(t, k, v)
        end,
    })
end

-- ── Toggle ────────────────────────────────────────────────
local function renderToggle(opt, parent)
    local H = 30
    local row = make("Frame", {
        Size = UDim2.new(1,0,0,H),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    local bg = make("Frame", {
        Size = UDim2.new(1,-4,1,-4),
        Position = UDim2.new(0,2,0,2),
        BackgroundColor3 = opt.state and C.accentD or C.panel2,
        BorderSizePixel = 0,
    }, row)
    stroke(C.shadow, 2, bg)

    local nameLbl = make("TextLabel", {
        Size = UDim2.new(1,-40,1,0),
        Position = UDim2.new(0,6,0,0),
        BackgroundTransparency = 1,
        Text = string.upper(tostring(opt.text or "TOGGLE")),
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = opt.state and C.accent or C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = bg.ZIndex + 1,
    }, bg)

    -- Pixel checkbox
    local box = make("Frame", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-5,0.5,0),
        Size = UDim2.new(0,22,0,22),
        BackgroundColor3 = opt.state and C.accent or C.panel,
        BorderSizePixel = 0,
        ZIndex = bg.ZIndex + 1,
    }, bg)
    stroke(C.shadow, 2, box)

    local checkImg = make("ImageLabel", {
        AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0.5,0,0.5,0),
        Size = UDim2.new(0,14,0,14),
        BackgroundTransparency = 1,
        Image = ICON.check,
        ImageColor3 = C.shadow,
        Visible = opt.state,
        ZIndex = box.ZIndex + 1,
    }, box)

    local debounce = false
    local function setState(v)
        if debounce then return end
        debounce = true
        opt.state = v
        MorLib.flags[opt.flag] = v
        bg.BackgroundColor3    = v and C.accentD or C.panel2
        nameLbl.TextColor3     = v and C.accent  or C.text
        box.BackgroundColor3   = v and C.accent  or C.panel
        checkImg.Visible       = v
        task.spawn(pcall, opt.callback, v)
        task.wait(0.06)
        debounce = false
    end

    function opt:SetState(v) setState(v) end

    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            setState(not opt.state)
        end
    end)
    bg.MouseEnter:Connect(function()
        if not opt.state then bg.BackgroundColor3 = C.panel3 end
    end)
    bg.MouseLeave:Connect(function()
        if not opt.state then bg.BackgroundColor3 = C.panel2 end
    end)
end

-- ── Button ────────────────────────────────────────────────
local function renderButton(opt, parent)
    local H = 32
    local row = make("Frame", {
        Size = UDim2.new(1,0,0,H),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    local btn = make("TextButton", {
        Size = UDim2.new(1,-4,1,-4),
        Position = UDim2.new(0,2,0,2),
        BackgroundColor3 = C.panel2,
        Text = "[ " .. string.upper(tostring(opt.text or "BUTTON")) .. " ]",
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = C.text,
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, row)
    stroke(C.shadow, 2, btn)

    -- Pixel top/left highlight lines
    make("Frame", { Size = UDim2.new(1,0,0,2), BackgroundColor3 = C.hilight,
        BorderSizePixel = 0, ZIndex = btn.ZIndex+1 }, btn)
    make("Frame", { Size = UDim2.new(0,2,1,0), BackgroundColor3 = C.hilight,
        BorderSizePixel = 0, ZIndex = btn.ZIndex+1 }, btn)

    btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = C.accentD
        btn.TextColor3 = C.accent
    end)
    btn.MouseButton1Up:Connect(function()
        btn.BackgroundColor3 = C.panel2
        btn.TextColor3 = C.text
        task.spawn(pcall, opt.callback)
    end)
    btn.MouseEnter:Connect(function()
        if btn.BackgroundColor3 ~= C.accentD then
            btn.BackgroundColor3 = C.panel3
        end
    end)
    btn.MouseLeave:Connect(function()
        if btn.BackgroundColor3 ~= C.accentD then
            btn.BackgroundColor3 = C.panel2
            btn.TextColor3 = C.text
        end
    end)
end

-- ── Slider ────────────────────────────────────────────────
local function renderSlider(opt, parent)
    local H = 50
    local row = make("Frame", {
        Size = UDim2.new(1,0,0,H),
        BackgroundColor3 = C.panel2,
        BorderSizePixel = 0,
        LayoutOrder = opt._order or 0,
    }, parent)
    stroke(C.shadow, 2, row)

    make("TextLabel", {
        Size = UDim2.new(0.65,0,0,20),
        Position = UDim2.new(0,6,0,4),
        BackgroundTransparency = 1,
        Text = string.upper(tostring(opt.text or "SLIDER")),
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valLbl = make("TextLabel", {
        Size = UDim2.new(0.35,-6,0,20),
        Position = UDim2.new(0.65,0,0,4),
        BackgroundTransparency = 1,
        Text = tostring(opt.value),
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = C.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local TRACK_H = 10
    local trackBg = make("Frame", {
        Size = UDim2.new(1,-12,0,TRACK_H),
        Position = UDim2.new(0,6,0,32),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, row)
    stroke(C.shadow, 2, trackBg)

    local pct0 = math.clamp((opt.value - opt.min) / math.max(1, opt.max - opt.min), 0, 1)

    local fill = make("Frame", {
        Size = UDim2.new(pct0,0,1,0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = trackBg.ZIndex + 1,
    }, trackBg)

    local THUMB_W, THUMB_H = 8, 16
    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(pct0,0,0.5,0),
        Size = UDim2.new(0,THUMB_W,0,THUMB_H),
        BackgroundColor3 = Color3.fromRGB(220,220,220),
        BorderSizePixel = 0,
        ZIndex = trackBg.ZIndex + 2,
    }, trackBg)
    stroke(C.shadow, 2, thumb)

    local sliding = false
    local float = opt.float or 1

    local function setValue(v)
        local r = math.floor(v / float + 0.5) * float
        r = math.clamp(r, opt.min, opt.max)
        opt.value = r
        MorLib.flags[opt.flag] = r
        local p = math.clamp((r - opt.min) / math.max(1, opt.max - opt.min), 0, 1)
        fill.Size      = UDim2.new(p,0,1,0)
        thumb.Position = UDim2.new(p,0,0.5,0)
        valLbl.Text    = tostring(r)
        task.spawn(pcall, opt.callback, r)
    end
    function opt:SetValue(v) setValue(v) end

    local function fromX(x)
        local p = math.clamp(
            (x - trackBg.AbsolutePosition.X) / math.max(1, trackBg.AbsoluteSize.X),
            0, 1)
        setValue(opt.min + p * (opt.max - opt.min))
    end

    trackBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            thumb.BackgroundColor3 = C.accent
            fromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            fromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and sliding then
            sliding = false
            thumb.BackgroundColor3 = Color3.fromRGB(220,220,220)
        end
    end)
end

-- ── Dropdown ──────────────────────────────────────────────
local function renderList(opt, parent)
    local BASE_H = 36

    local wrapper = make("Frame", {
        Size = UDim2.new(1,0,0,BASE_H),
        BackgroundColor3 = C.panel2,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        LayoutOrder = opt._order or 0,
    }, parent)
    stroke(C.shadow, 2, wrapper)

    local header = make("Frame", {
        Size = UDim2.new(1,0,0,BASE_H),
        BackgroundTransparency = 1,
        ZIndex = wrapper.ZIndex + 1,
    }, wrapper)

    local headerLbl = make("TextLabel", {
        Size = UDim2.new(1,-30,1,0),
        Position = UDim2.new(0,6,0,0),
        BackgroundTransparency = 1,
        Text = string.upper(tostring(opt.text)) .. ": " .. string.upper(tostring(opt.value)),
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = header.ZIndex,
    }, header)

    local arrowImg = make("ImageLabel", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-6,0.5,0),
        Size = UDim2.new(0,16,0,16),
        BackgroundTransparency = 1,
        Image = ICON.arrow,
        ImageColor3 = C.textDim,
        Rotation = 0,
        ZIndex = header.ZIndex,
    }, header)

    local popup = make("Frame", {
        Position = UDim2.new(0,0,1,2),
        Size = UDim2.new(1,0,0,0),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 20,
        Visible = false,
    }, wrapper)
    stroke(C.shadow, 2, popup)

    local popLayout = layout(popup, 1)
    pad(2,2,2,2,popup)

    opt._open = false

    local function closeList()
        opt._open = false
        arrowImg.Rotation = 0
        tw(wrapper, { Size = UDim2.new(1,0,0,BASE_H) }, 0.15)
        tw(popup, { Size = UDim2.new(1,0,0,0) }, 0.15)
        task.delay(0.16, function()
            if not opt._open then popup.Visible = false end
        end)
    end

    local function openList()
        opt._open = true
        arrowImg.Rotation = 180
        popup.Visible = true
        local count = math.min(#opt.values, 5)
        local popH  = count * 28 + 4
        tw(popup,   { Size = UDim2.new(1,0,0,popH) }, 0.15)
        tw(wrapper, { Size = UDim2.new(1,0,0,BASE_H + popH + 4) }, 0.15)
    end

    local function addValue(value)
        local item = make("TextButton", {
            Size = UDim2.new(1,0,0,26),
            BackgroundColor3 = C.panel2,
            Text = "> " .. string.upper(tostring(value)),
            TextSize = FS_SM,
            Font = PX_FONT,
            TextColor3 = C.text,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 21,
        }, popup)
        item.MouseButton1Click:Connect(function()
            opt.value = tostring(value)
            MorLib.flags[opt.flag] = opt.value
            headerLbl.Text = string.upper(tostring(opt.text)) .. ": " .. string.upper(tostring(value))
            task.spawn(pcall, opt.callback, value)
            closeList()
        end)
        item.MouseEnter:Connect(function()
            item.BackgroundColor3 = C.accentD
            item.TextColor3 = C.accent
        end)
        item.MouseLeave:Connect(function()
            item.BackgroundColor3 = C.panel2
            item.TextColor3 = C.text
        end)
    end

    for _, v in ipairs(opt.values or {}) do addValue(tostring(v)) end

    function opt:AddValue(v) addValue(tostring(v)) end
    function opt:SetValue(v)
        self.value = tostring(v)
        MorLib.flags[self.flag] = self.value
        headerLbl.Text = string.upper(tostring(self.text)) .. ": " .. string.upper(tostring(v))
        task.spawn(pcall, self.callback, v)
    end
    function opt:Close() closeList() end

    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            if opt._open then closeList() else openList() end
        end
    end)
    header.MouseEnter:Connect(function() wrapper.BackgroundColor3 = C.panel3 end)
    header.MouseLeave:Connect(function() wrapper.BackgroundColor3 = C.panel2 end)
end

-- ── Bind ──────────────────────────────────────────────────
local BIND_BLACKLIST = {
    Enum.KeyCode.Unknown, Enum.KeyCode.Return, Enum.KeyCode.Escape,
    Enum.KeyCode.Tab, Enum.KeyCode.Backspace, Enum.KeyCode.Delete, Enum.KeyCode.CapsLock,
}

local function renderBind(opt, parent)
    local H = 30
    local row = make("Frame", {
        Size = UDim2.new(1,0,0,H),
        BackgroundTransparency = 1,
        LayoutOrder = opt._order or 0,
    }, parent)

    local bg = make("Frame", {
        Size = UDim2.new(1,-4,1,-4),
        Position = UDim2.new(0,2,0,2),
        BackgroundColor3 = C.panel2,
        BorderSizePixel = 0,
    }, row)
    stroke(C.shadow, 2, bg)

    -- Key icon
    make("ImageLabel", {
        AnchorPoint = Vector2.new(0,0.5),
        Position = UDim2.new(0,5,0.5,0),
        Size = UDim2.new(0,14,0,14),
        BackgroundTransparency = 1,
        Image = ICON.key,
        ImageColor3 = C.textDim,
        ZIndex = bg.ZIndex + 1,
    }, bg)

    make("TextLabel", {
        Size = UDim2.new(0.55,0,1,0),
        Position = UDim2.new(0,22,0,0),
        BackgroundTransparency = 1,
        Text = string.upper(tostring(opt.text or "BIND")),
        TextSize = FS_MD,
        Font = PX_FONT,
        TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = bg.ZIndex + 1,
    }, bg)

    local keyBox = make("Frame", {
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-4,0.5,0),
        Size = UDim2.new(0,62,0,20),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        ZIndex = bg.ZIndex + 1,
    }, bg)
    stroke(C.shadow, 2, keyBox)

    local keyLbl = make("TextLabel", {
        Size = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text = tostring(opt.key or "F"),
        TextSize = FS_SM,
        Font = PX_FONT,
        TextColor3 = C.accent,
        ZIndex = keyBox.ZIndex + 1,
    }, keyBox)

    local binding = false
    local loop

    local function setKey(key)
        binding = false
        local name = type(key) == "string" and key or (key.Name or "F")
        opt.key = name
        MorLib.flags[opt.flag] = name
        keyLbl.Text = name
        keyBox.BackgroundColor3 = C.panel
        keyLbl.TextColor3 = C.accent
    end
    function opt:SetKey(k) setKey(k) end

    keyBox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            if binding then return end
            binding = true
            keyLbl.Text = "..."
            keyBox.BackgroundColor3 = C.accentD
            keyLbl.TextColor3 = C.shadow
        end
    end)

    UserInputService.InputBegan:Connect(function(i)
        if UserInputService:GetFocusedTextBox() then return end
        if binding then
            if i.KeyCode == Enum.KeyCode.Escape then setKey(opt.key); return end
            for _, k in ipairs(BIND_BLACKLIST) do
                if k == i.KeyCode then return end
            end
            setKey(i.KeyCode)
            return
        end
        if i.KeyCode.Name == opt.key or i.UserInputType.Name == opt.key then
            if opt.hold then
                loop = RunService.Heartbeat:Connect(function() pcall(opt.callback) end)
            else
                task.spawn(pcall, opt.callback)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if (i.KeyCode.Name == opt.key or i.UserInputType.Name == opt.key) and loop then
            loop:Disconnect(); loop = nil
        end
    end)

    keyBox.MouseEnter:Connect(function()
        if not binding then keyBox.BackgroundColor3 = C.panel3 end
    end)
    keyBox.MouseLeave:Connect(function()
        if not binding then keyBox.BackgroundColor3 = C.panel end
    end)
end

