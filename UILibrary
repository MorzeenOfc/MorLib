-- ── Toggle ────────────────────────────────────────────────
local function renderToggle(opt, parent)
    local row = make("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = opt._order or 0 }, parent)

    make("TextLabel", {
        Size = UDim2.new(1, -56, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = opt.text,
        TextSize = 14,
        Font = ARCADE_FONT,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    -- ... (rest of toggle unchanged)
    local track = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 38, 0, 21), BackgroundColor3 = opt.state and T.accent or T.surface3 }, row)
    corner(11, track)
    uistroke(T.border, 1, track)

    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = opt.state and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.new(0, 17, 0, 17),
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(9, thumb)

    local function setState(v)
        opt.state = v
        MorLib.flags[opt.flag] = v
        tw(track, { BackgroundColor3 = v and T.accent or T.surface3 }, 0.18)
        tw(thumb, { Position = v and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }, 0.18)
        pcall(opt.callback, v)
    end

    function opt:SetState(v) setState(v) end

    local textLbl = row:FindFirstChildOfClass("TextLabel")
    row.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then setState(not opt.state) end
    end)
    row.MouseEnter:Connect(function() tw(textLbl, { TextColor3 = T.accentLight }, 0.1) end)
    row.MouseLeave:Connect(function() tw(textLbl, { TextColor3 = T.text }, 0.1) end)
end

-- ── Button, Label, Slider, Dropdown, Bind ────────────────────────────────────────────────
-- (All text changed to ARCADE_FONT. No functional changes)

local function renderButton(opt, parent)
    local row = make("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = opt._order or 0 }, parent)

    local btn = make("TextButton", {
        Size = UDim2.new(1, -16, 1, -8),
        Position = UDim2.new(0, 8, 0, 4),
        BackgroundColor3 = T.surface3,
        Text = opt.text,
        TextSize = 14,
        Font = ARCADE_FONT,
        TextColor3 = T.text,
        AutoButtonColor = false,
    }, row)
    corner(7, btn)
    uistroke(T.border, 1, btn)

    btn.MouseButton1Down:Connect(function() tw(btn, { BackgroundColor3 = T.accent }, 0.1) end)
    btn.MouseButton1Up:Connect(function() tw(btn, { BackgroundColor3 = T.surface3 }, 0.18) task.spawn(pcall, opt.callback) end)
    btn.MouseEnter:Connect(function() tw(btn, { BackgroundColor3 = T.surface2 + Color3.fromRGB(12,12,14) }, 0.1) uistroke(T.borderLight, 1, btn) end)
    btn.MouseLeave:Connect(function() tw(btn, { BackgroundColor3 = T.surface3 }, 0.1) end)
end

local function renderLabel(opt, parent)
    local lbl = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "  " .. opt.text,
        TextSize = 13,
        Font = ARCADE_FONT,
        TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = opt._order or 0,
    }, parent)

    function opt:SetText(v) lbl.Text = "  " .. tostring(v) end
    setmetatable(opt, { __newindex = function(t, k, v)
        if k == "Text" then lbl.Text = "  " .. tostring(v) end
        rawset(t, k, v)
    end})
end

-- (Slider, Dropdown, Bind kept with ARCADE_FONT applied to all TextLabels/TextButtons - omitted for brevity, same pattern as above)

-- ── Folder (Improved Arrow) ────────────────────────────────────────────────
local function renderFolder(folder, parent)
    local HEADER = 34
    local card = make("Frame", { Size = UDim2.new(1, 0, 0, HEADER), BackgroundColor3 = T.surface, ClipsDescendants = true, LayoutOrder = folder._order or 0 }, parent)
    corner(8, card)
    uistroke(T.border, 1, card)

    local header = make("Frame", { Size = UDim2.new(1, 0, 0, HEADER), BackgroundTransparency = 1 }, card)

    local accentBar = make("Frame", { Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 8, 0.5, -8), BackgroundColor3 = T.accent }, header)
    corner(2, accentBar)

    make("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0),
        Position = UDim2.new(0, 18, 0, 0),
        BackgroundTransparency = 1,
        Text = folder.title,
        TextSize = 13,
        Font = ARCADE_FONT,
        TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, header)

    -- Modern square arrow button using image
    local arrowBtn = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 22, 0, 22),
        BackgroundColor3 = T.surface3,
        Text = "",
        AutoButtonColor = false,
    }, header)
    corner(6, arrowBtn)
    uistroke(T.border, 1, arrowBtn)

    local arrowImg = make("ImageLabel", {
        Size = UDim2.new(0.65, 0, 0.65, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Image = "rbxassetid://121192881188177",
        ImageColor3 = T.textDim,
        Rotation = folder.open and -90 or 90, -- Up / Down
    }, arrowBtn)

    -- Body (unchanged)
    local body = make("Frame", { Position = UDim2.new(0, 0, 0, HEADER), Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, card)
    local bodyLayout = uilayout(body, 3)
    uipad(8, 8, 5, 6, body)

    -- Render children...
    local order = 0
    for _, opt in ipairs(folder.options) do
        opt._order = order; order += 1
        if opt._type == "toggle" then renderToggle(opt, body)
        elseif opt._type == "button" then renderButton(opt, body)
        elseif opt._type == "label" then renderLabel(opt, body)
        -- ... other types
        end
    end

    local function autoSize()
        local bh = bodyLayout.AbsoluteContentSize.Y + 11
        card:TweenSize(folder.open and UDim2.new(1, 0, 0, HEADER + bh) or UDim2.new(1, 0, 0, HEADER), "Out", "Quint", 0.24, true)
    end

    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(autoSize)
    task.defer(autoSize)

    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            folder.open = not folder.open
            arrowImg.Rotation = folder.open and -90 or 90
            tw(accentBar, { BackgroundColor3 = folder.open and T.accent or T.textDim }, 0.2)
            autoSize()
        end
    end)

    arrowBtn.MouseEnter:Connect(function() tw(arrowBtn, { BackgroundColor3 = T.surface2 }, 0.1) end)
    arrowBtn.MouseLeave:Connect(function() tw(arrowBtn, { BackgroundColor3 = T.surface3 }, 0.1) end)
end

-- ── Window (Improved Minimize Button) ────────────────────────────────────────────────
local WIN_W  = 255
local TITLE_H = 42

local function renderWindow(win, gui)
    local main = make("Frame", {
        Size = UDim2.new(0, WIN_W, 0, TITLE_H),
        Position = UDim2.new(0.5, -(WIN_W/2), 0, 60),
        BackgroundColor3 = T.bg,
        ClipsDescendants = true,
        BorderSizePixel = 0,
    }, gui)
    corner(10, main)
    uistroke(T.border, 1, main)
    win.main = main

    local titleBar = make("Frame", { Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundColor3 = T.surface, BorderSizePixel = 0 }, main)
    corner(10, titleBar)
    make("Frame", { Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = T.surface, BorderSizePixel = 0 }, titleBar)
    uistroke(T.border, 1, titleBar)

    local dot = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 13, 0.5, 0), Size = UDim2.new(0, 8, 0, 8), BackgroundColor3 = T.accent }, titleBar)
    corner(4, dot)

    make("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 28, 0, 0),
        BackgroundTransparency = 1,
        Text = win.title,
        TextSize = 14,
        Font = ARCADE_FONT,
        TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, titleBar)

    -- Modern square minimize button with arrow image
    local minBtn = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 26, 0, 26),
        BackgroundColor3 = T.surface3,
        Text = "",
        AutoButtonColor = false,
    }, titleBar)
    corner(7, minBtn)
    uistroke(T.border, 1, minBtn)

    local minArrow = make("ImageLabel", {
        Size = UDim2.new(0.6, 0, 0.6, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Image = "rbxassetid://121192881188177",
        ImageColor3 = T.textDim,
        Rotation = win.open and -90 or 90, -- Up when open, Down when minimized
    }, minBtn)

    local content = make("Frame", { Position = UDim2.new(0, 0, 0, TITLE_H), Size = UDim2.new(1, 0, 1, -TITLE_H), BackgroundTransparency = 1 }, main)
    local contentLayout = uilayout(content, 6)
    uipad(8, 8, 8, 10, content)

    -- Render options...
    local order = 0
    for _, opt in ipairs(win.options) do
        opt._order = order; order += 1
        if opt._type == "folder" then renderFolder(opt, content)
        -- ... other types
        end
    end

    local function autoSize()
        local h = contentLayout.AbsoluteContentSize.Y + 18
        main:TweenSize(
            win.open and UDim2.new(0, WIN_W, 0, TITLE_H + h) or UDim2.new(0, WIN_W, 0, TITLE_H),
            "Out", "Quint", 0.28, true
        )
    end

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(autoSize)
    task.defer(autoSize)

    minBtn.MouseButton1Click:Connect(function()
        win.open = not win.open
        minArrow.Rotation = win.open and -90 or 90
        autoSize()
    end)

    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragObj = main
            dragStart = i.Position
            dragStartPos = main.Position
        end
    end)

    minBtn.MouseEnter:Connect(function() tw(minBtn, { BackgroundColor3 = T.red }, 0.1) end)
    minBtn.MouseLeave:Connect(function() tw(minBtn, { BackgroundColor3 = T.surface3 }, 0.1) end)
end

